# ===== 必填 =====
# 模型 API（OpenAI 兼容）
COMPANION_API_KEY=sk-your-key-here
COMPANION_API_BASE=https://api.deepseek.com
COMPANION_API_MODEL=deepseek-chat

# ===== 网络 =====
COMPANION_HOST=0.0.0.0
COMPANION_PORT=8787
# 加密端口（有 tls/cert.pem + tls/key.pem 时自动启用）
COMPANION_TLS_PORT=8443
# 对外域名或 IP（跳转和展示用）
COMPANION_PUBLIC_HOST=YOUR_SERVER_HOST
# 1 = 明文端口只放静态文件，其余全部跳到 HTTPS
COMPANION_FORCE_HTTPS=0

# ===== 主动消息 =====
# app = 写进消息表，由 App 的长轮询推送（本仓库只带这条通道）
PROACTIVE_CHANNEL=app

# ===== 自主阅读 =====
CURIOSITY_ENABLED=1
CURIOSITY_INTERVAL_H=4
CURIOSITY_DAILY_YUAN=5

# ===== 自研究 =====
RESEARCH_DAILY_YUAN=1

# ===== 每日状态推送（1=开 0=关）=====
DAILY_TASK_ENABLED=0
DAILY_TASK_TIME=10:00

# ===== 其它可调项（不填就用默认）=====
# ALL_DAILY_YUAN=
# 没有 API key 时的占位回复（调试用，可留空）
# COMPANION_STUB_REPLY=
# 访问口令；不填则首次运行自动生成到 data/token.txt
# COMPANION_TOKEN=
# 1 = 打印更多日志
# COMPANION_VERBOSE=
# CURIOSITY_MAX_ITEMS=
# INNER_AUTONOMY=
# 记忆抽取每日预算（元），超了就暂停抽取（不阻塞说话）
# MEMORY_DAILY_YUAN=
# MEMORY_MIN_CHARS=
